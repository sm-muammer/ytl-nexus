{
  "name": "ytl-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "YTL Nexus: unified infrastructure, AI, file transfer, mail and content platform built during a YTL Communications IT Infrastructure internship.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "assets:convert": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/assets/convert.ts && prettier --write assets/asset-manifest.md",
    "assets:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/assets/check-filenames.ts",
    "migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/migrate.ts up",
    "migrate:down": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/migrate.ts down",
    "migrate:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/migrate.ts status",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/seed.ts",
    "db:provision": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/provision.ts",
    "auth:create-user": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/auth/create-user.ts",
    "db:test:up": "docker compose -f infrastructure/database/docker-compose.yml up -d --wait",
    "db:test:down": "docker compose -f infrastructure/database/docker-compose.yml down",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "better-auth": "^1.7.15",
    "kysely": "^0.29.8",
    "motion": "^14.9.0",
    "mysql2": "^3.24.6",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
