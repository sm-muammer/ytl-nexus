# YTL Nexus environment variables.
# Copy to .env.local for local development. Never commit real values.
# Production values live on the server in /etc/ytl-nexus/*.env (Task 4).
# Every variable is documented in docs/operations/configuration.md as it is added.

# Required for dev, build and start. Anything but "live" or "demo" stops the server.
# live: talk to real services. demo: run the full UI on fixtures with no server calls.
NEXUS_MODE=demo
# Live mode only (NEXUS_MODE=live): the database and authentication. Demo mode reads none of these.
# NEXUS_DB_HOST=127.0.0.1
# NEXUS_DB_PORT=3306
# NEXUS_DB_NAME=ytl_nexus
# NEXUS_DB_USER=nexus_app
# NEXUS_DB_PASSWORD=
# BETTER_AUTH_SECRET=        # at least 32 characters; encrypts stored TOTP secrets
# BETTER_AUTH_URL=http://localhost:3000
# NEXUS_TRUSTED_ORIGINS=     # optional, comma-separated
# Live mode only: Nexus Studio (headless WordPress), see docs/operations/wordpress.md
# NEXUS_WP_URL=http://127.0.0.1:8081/studio
# NEXUS_WP_USER=nexus-reader
# NEXUS_WP_APP_PASSWORD=
# NEXUS_WP_WEBHOOK_SECRET=   # at least 32 characters
