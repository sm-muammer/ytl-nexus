{
  "common": {
    "idle_timeout": 15,
    "max_per_host_connections": 20,
    "defender": {
      "enabled": true,
      "driver": "memory",
      "ban_time": 30,
      "ban_time_increment": 50,
      "threshold": 5,
      "score_invalid": 1,
      "score_valid": 1,
      "score_limit_exceeded": 3,
      "score_no_auth": 0,
      "observation_time": 10,
      "entries_soft_limit": 100,
      "entries_hard_limit": 150,
      "login_delay": { "success": 0, "password_failed": 1000 }
    },
    "rate_limiters": [
      {
        "average": 5,
        "period": 1000,
        "burst": 10,
        "type": 2,
        "protocols": ["SSH"],
        "generate_defender_events": true,
        "entries_soft_limit": 100,
        "entries_hard_limit": 150
      },
      {
        "average": 50,
        "period": 1000,
        "burst": 100,
        "type": 2,
        "protocols": ["HTTP"],
        "generate_defender_events": true,
        "entries_soft_limit": 100,
        "entries_hard_limit": 150
      }
    ]
  },
  "sftpd": {
    "bindings": [{ "port": 2022, "address": "", "apply_proxy_config": false }],
    "max_auth_tries": 6,
    "host_keys": [
      "/var/lib/sftpgo/hostkeys/ssh_host_ed25519_key",
      "/var/lib/sftpgo/hostkeys/ssh_host_rsa_key"
    ],
    "password_authentication": true,
    "keyboard_interactive_authentication": false
  },
  "ftpd": {
    "bindings": [{ "port": 0, "address": "", "apply_proxy_config": false }]
  },
  "webdavd": {
    "bindings": [{ "port": 0, "address": "" }]
  },
  "data_provider": {
    "driver": "mysql",
    "name": "nexus_sftpgo",
    "host": "127.0.0.1",
    "port": 3306,
    "username": "nexus_sftpgo",
    "track_quota": 2,
    "users_base_dir": "/srv/nexus-transfer",
    "backups_path": "/var/lib/sftpgo/backups",
    "create_default_admin": true,
    "password_hashing": { "algo": "argon2id" },
    "password_validation": {
      "admins": { "min_entropy": 60 },
      "users": { "min_entropy": 50 }
    }
  },
  "httpd": {
    "web_root": "/files",
    "bindings": [
      {
        "port": 8090,
        "address": "127.0.0.1",
        "enable_web_admin": false,
        "enable_web_client": true,
        "enable_rest_api": false,
        "enable_https": false,
        "proxy_mode": 0,
        "proxy_allowed": ["127.0.0.1"],
        "client_ip_proxy_header": "X-Real-IP",
        "client_ip_header_depth": 0,
        "render_openapi": false,
        "security": {
          "enabled": true,
          "https_proxy_headers": [
            { "key": "X-Forwarded-Proto", "value": "https" }
          ],
          "content_type_nosniff": true,
          "referrer_policy": "same-origin"
        },
        "branding": {
          "web_client": { "name": "Nexus Transfer", "short_name": "Transfer" }
        }
      },
      {
        "port": 8091,
        "address": "127.0.0.1",
        "enable_web_admin": true,
        "enable_web_client": false,
        "enable_rest_api": true,
        "enable_https": false,
        "render_openapi": false,
        "security": {
          "enabled": true,
          "content_type_nosniff": true,
          "referrer_policy": "same-origin"
        },
        "branding": {
          "web_admin": { "name": "Nexus Transfer admin", "short_name": "Admin" }
        }
      }
    ]
  },
  "telemetry": {
    "bind_port": 10000,
    "bind_address": "127.0.0.1",
    "enable_profiler": false
  }
}
