#!/usr/bin/env bash
# setup-database-grants: task 5.6. Runs on the server (use server-run).
#
# Applies the table-level grants for nexus_app and nexus_ingest from the TypeScript
# source of truth (lib/server/db/provision.ts) in the current release. Run it after
# any deploy whose migrations added a table. Needs the release's node_modules, which
# `deploy.sh` builds. Safe to repeat: it first removes the two users' old privileges.
set -Eeuo pipefail
OPS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$OPS_DIR/verify-target" --local
cd /opt/ytl-nexus/current
NEXUS_DB_ADMIN_SOCKET=/var/lib/mysql/mysql.sock NEXUS_DB_NAME=ytl_nexus \
  node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/provision.ts grants
