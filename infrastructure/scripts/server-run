#!/usr/bin/env bash
# server-run <script> [args...]   Run from the Mac.
#
# Verifies the target (gate 1), uploads the ops scripts and their config files to
# /root/nexus-ops on Nexus Core 01, then runs one script there as root.
#
#   infrastructure/scripts/server-run setup-runtimes node
#   infrastructure/scripts/server-run remove-old-content --list

set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INFRA="$(cd "$HERE/.." && pwd)"
ROOT="$(cd "$INFRA/.." && pwd)"
SSH_TARGET="${NEXUS_SSH_TARGET:-root@10.26.64.164}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"

[ $# -ge 1 ] || { echo "usage: server-run <script> [args...]" >&2; exit 2; }
script="$1"
shift
[ -f "$HERE/$script" ] || { echo "server-run: no such script: $script" >&2; exit 2; }

"$HERE/verify-target"

# shellcheck disable=SC2086
ssh $SSH_OPTS "$SSH_TARGET" 'install -d -m 700 /root/nexus-ops' 2> >(grep -v -E 'post-quantum|store now|may need to be upgraded' >&2)
# shellcheck disable=SC2086
scp -q $SSH_OPTS "$HERE"/* "$INFRA/apache/ytl-nexus.conf" "$INFRA/apache/studio.inc" \
  "$INFRA/apache/webmail.inc" "$INFRA/php-fpm/wordpress.conf" "$INFRA/php-fpm/webmail.conf" \
  "$INFRA/systemd/nexus-web.service" \
  "$INFRA/systemd/prometheus.service" "$INFRA/prometheus/prometheus.yml" \
  "$INFRA/systemd/nexus-ops.service" "$INFRA/systemd/nexus-worker.service" \
  "$INFRA/polkit/50-nexus-ops.rules" "$INFRA/apache/files.inc" "$INFRA/systemd/sftpgo-nexus.conf" \
  "$SSH_TARGET:/root/nexus-ops/" 2> >(grep -v -E 'post-quantum|store now|may need to be upgraded' >&2)
# shellcheck disable=SC2086
scp -q -r $SSH_OPTS "$INFRA/wordpress" "$INFRA/sftpgo" "$INFRA/mail" "$ROOT/roundcube" "$SSH_TARGET:/root/nexus-ops/" \
  2> >(grep -v -E 'post-quantum|store now|may need to be upgraded' >&2)
# shellcheck disable=SC2086
ssh $SSH_OPTS "$SSH_TARGET" "chmod 700 /root/nexus-ops/* && /root/nexus-ops/$script $*" \
  2> >(grep -v -E 'post-quantum|store now|may need to be upgraded' >&2)
