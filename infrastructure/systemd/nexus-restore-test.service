[Unit]
Description=YTL Nexus weekly root restore verification test
Documentation=https://github.com/sm-muammer/ytl-nexus
After=network.target mariadb.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/ytl-nexus/current/infrastructure/scripts/nexus-restore-test
StandardOutput=journal
StandardError=journal
