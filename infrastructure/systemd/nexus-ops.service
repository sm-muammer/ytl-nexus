# YTL Nexus operations agent. Installed as /etc/systemd/system/nexus-ops.service
# by `setup-ops`. Requirements 9.1 to 9.10 (OPS-01 to OPS-07). Check the sandbox with:
#   systemd-analyze security nexus-ops
#
# The agent runs as the unprivileged `nexus-ops` user. Its primary group for this
# process is nexus-ops-clients, so the socket under /run/nexus-ops is reachable
# only by that group, whose sole member is the `nexus` (nexus-web) user. It can
# restart four units, and only because the polkit rule
# /etc/polkit-1/rules.d/50-nexus-ops.rules says so.
[Unit]
Description=YTL Nexus operations agent
Documentation=https://github.com/sm-muammer/ytl-nexus
After=network.target dbus.service polkit.service

[Service]
Type=simple
User=nexus-ops
Group=nexus-ops-clients
# Read the journal of other units. Nothing else is gained from this group.
SupplementaryGroups=systemd-journal
# systemd reads this file as root; the agent user cannot read it from disk.
EnvironmentFile=/etc/ytl-nexus/ops.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/ytl-nexus/current
ExecStart=/usr/bin/node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON /opt/ytl-nexus/current/services/ops-agent/main.ts
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

# The socket directory: /run/nexus-ops, owner nexus-ops, group nexus-ops-clients, 0750.
RuntimeDirectory=nexus-ops
RuntimeDirectoryMode=0750
UMask=0007

# Sandbox.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Health checks only ever connect to the loopback interface.
IPAddressDeny=any
IPAddressAllow=localhost
# V8 needs writable and executable memory, so MemoryDenyWriteExecute stays off.
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
# No ReadWritePaths: the agent writes nothing to disk.

[Install]
WantedBy=multi-user.target
